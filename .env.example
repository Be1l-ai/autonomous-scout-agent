# =============================================================================
# REQUIRED — the only key the agent cannot run without
# =============================================================================
# Groq, free tier: https://console.groq.com/keys  (key looks like gsk_...)
WORKER_API_KEY=

# =============================================================================
# STRONGLY RECOMMENDED — how the agent finds new corners of the web
# Without this it can only follow links out from SEED_URLS and will eventually
# exhaust that neighbourhood. Pick ONE provider.
# =============================================================================
#   brave   -> https://brave.com/search/api/      2,000 queries/mo free
#   tavily  -> https://tavily.com                 1,000 credits/mo free
#   searxng -> your own SearXNG instance          free, no key, self-hosted
#   none    -> link-following only
SEARCH_PROVIDER=none
SEARCH_API_KEY=
SEARXNG_URL=
# Leave empty and the scout invents queries from CURRENT_GOAL each round.
SEARCH_QUERIES=
SEARCH_RESULTS_PER_QUERY=10
SEARCH_ON_EMPTY_QUEUE=true

# =============================================================================
# What the agent is looking for
# =============================================================================
CURRENT_GOAL=Find open-source AI agent frameworks and their source repositories.
# Optional manual entry points (comma-separated). Not needed if search is on.
SEED_URLS=

# =============================================================================
# Crawl scope
# =============================================================================
# EMPTY = the open web. Add host suffixes to fence the agent in, e.g. github.com
ALLOWED_DOMAINS=
# Hosts never worth crawling. See DEFAULT_BLOCKLIST in config.py for the default.
# BLOCKED_DOMAINS=
MAX_DEPTH=3
MAX_QUEUE_SIZE=2000
MAX_PAGES_PER_DOMAIN=25
MAX_PAGES=0

# =============================================================================
# Politeness — lower these at your own risk
# =============================================================================
RESPECT_ROBOTS=true
MIN_DELAY_SECONDS=2.0
MAX_DELAY_SECONDS=5.0
PER_DOMAIN_DELAY_SECONDS=15.0

# =============================================================================
# Scout (local CPU model) — free, no key
# =============================================================================
SCOUT_THREADS=2
SCOUT_CONTEXT_SIZE=4096
SCOUT_TEMPERATURE=0.1
SCOUT_MIN_CONFIDENCE=0.4

# =============================================================================
# Runtime
# =============================================================================
WORKER_MODEL=llama-3.1-8b-instant
DB_PATH=./data/agent_state.db
AUTOSTART=true
LOG_LEVEL=info
